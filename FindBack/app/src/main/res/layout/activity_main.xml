<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <android.opengl.GLSurfaceView
      android:id="@+id/surfaceview"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <!-- "Use a spot": the spot's saved camera view at about 45% opacity. Placed with a matrix from the
       same view-to-image mapping as the camera background. Not clickable: touches pass through. -->
  <ImageView
      android:id="@+id/ghostImage"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:alpha="0.45"
      android:scaleType="matrix"
      android:visibility="gone" />

  <!-- 2D guidance: ring on the target when visible, edge arrow when not. Does not consume touches. -->
  <edu.cs6301.findback.GuidanceOverlay
      android:id="@+id/guidanceOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <!-- Top: status panel (tap or long-press: location sheet) and the mini-map below it, at the right.
       The container itself is not clickable, so touches beside the mini-map reach the camera view. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:layout_marginTop="36dp"
      android:orientation="vertical">

  <!-- Status: tracking, map location, item count, room chip, and a one-line hint. -->
  <LinearLayout
      android:id="@+id/statusPanel"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="12dp"
      android:background="@drawable/panel_bg"
      android:orientation="vertical"
      android:paddingHorizontal="14dp"
      android:paddingVertical="10dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:text="Starting…" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />

    <!-- Room chip: the current room; tap to pick another, "New room…" or "No room". -->
    <TextView
        android:id="@+id/roomChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
  </LinearLayout>

  <edu.cs6301.findback.MiniMapView
      android:id="@+id/miniMap"
      android:layout_width="120dp"
      android:layout_height="120dp"
      android:layout_gravity="end"
      android:layout_marginTop="8dp"
      android:layout_marginEnd="12dp"
      android:visibility="gone" />
  </LinearLayout>

  <!-- Spot lock bar: instructions plus Cancel and Lock. Clickable so taps do not reach the camera. -->
  <LinearLayout
      android:id="@+id/lockBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:layout_marginBottom="92dp"
      android:layout_marginHorizontal="12dp"
      android:background="@drawable/panel_bg"
      android:clickable="true"
      android:focusable="true"
      android:orientation="vertical"
      android:padding="12dp"
      android:visibility="gone"
      app:layout_dodgeInsetEdges="bottom">

    <TextView
        android:id="@+id/lockText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

      <Button
          android:id="@+id/lockCancel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="4dp"
          android:text="Cancel" />

      <Button
          android:id="@+id/lockButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:text="Lock" />
    </LinearLayout>
  </LinearLayout>

  <!-- Guidance card for the selected target. -->
  <LinearLayout
      android:id="@+id/guideCard"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:layout_marginBottom="92dp"
      android:layout_marginHorizontal="12dp"
      android:background="@drawable/panel_bg"
      android:clickable="true"
      android:focusable="true"
      android:orientation="vertical"
      android:padding="12dp"
      android:visibility="gone"
      app:layout_dodgeInsetEdges="bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/guideThumb"
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:scaleType="centerCrop" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="12dp"
          android:orientation="vertical">

        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guideSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/guideCue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
      </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/guidePolicy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/guideVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:layout_marginBottom="28dp"
      android:layout_marginHorizontal="8dp"
      android:gravity="center"
      android:orientation="horizontal"
      app:layout_dodgeInsetEdges="bottom">

    <Button
        android:id="@+id/itemsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:text="Items" />

    <Button
        android:id="@+id/verifyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:enabled="false"
        android:text="Verify" />

    <Button
        android:id="@+id/doneButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:enabled="false"
        android:text="Done" />
  </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
